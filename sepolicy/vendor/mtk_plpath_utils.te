#
# mtk_plpath_utils —— MTK UFS preloader 路径工具
#
# ════════════════════════════════════════════════════════════════════════
# 这个文件为什么存在
# ════════════════════════════════════════════════════════════════════════
#
# 原厂把 /system/bin/mtk_plpath_utils 的类型定义在 **system_ext 策略**里，
# 而 LineageOS 的 system_ext 是从源码重建的，那层策略不复存在。
# 但原厂 vendor_boot ramdisk 的 system_ext_file_contexts 第 50 行仍然引用
# 这个类型：
#       /system/bin/mtk_plpath_utils u:object_r:mtk_plpath_utils_exec:s0
#
# 所以类型必须由设备树补上，否则 file_contexts 会指向一个不存在的类型。
#
# ════════════════════════════════════════════════════════════════════════
# 两种调用方式（都来自原厂 init.recovery.mt6983.rc）
# ════════════════════════════════════════════════════════════════════════
#
#   1) 第 12 行，recovery 里由 init 直接 exec，**显式指定运行域**：
#          on boot
#              exec u:r:update_engine:s0 root root -- /system/bin/mtk_plpath_utils
#      注意这里指定的是 update_engine 域，不是 mtk_plpath_utils 域。
#
#   2) 原厂 vendor_boot ramdisk 的 system/etc/init/mtk-plpath-utils.rc，
#      作为一个 oneshot 服务启动：
#          service mtk.plpath.utils.link /system/bin/mtk_plpath_utils
#              class main
#              user root
#              group root system
#              oneshot
#              disabled
#      没有写 seclabel，所以走 init_daemon_domain 的自动域转换。
#
# 源码：mtk_plpath_utils/mtk_plpath_utils.cpp

# ── 类型声明（必需）────────────────────────────────────────────────────
type mtk_plpath_utils, domain;
type mtk_plpath_utils_exec, exec_type, vendor_file_type, file_type;

# ── 方式 2：作为服务启动 ───────────────────────────────────────────────
init_daemon_domain(mtk_plpath_utils)

# ── 方式 1：由 update_engine 域 exec ───────────────────────────────────
# 显式 u:r:update_engine:s0 已经跳过了域转换，但 update_engine 仍需要有
# 执行这个文件的权限。
allow update_engine mtk_plpath_utils_exec:file { read open getattr map execute execute_no_trans entrypoint };

# ════════════════════════════════════════════════════════════════════════
# 下面的功能权限是**起步版本**
# ════════════════════════════════════════════════════════════════════════
#
# 工具做的事：读 /dev/block/sda、sdb 的 preloader 头部，通过 device-mapper
# 建出 pl_a / pl_b，供 init 的 symlink 规则使用。
#
# 这些规则是**根据功能推断**的，不是从原厂策略里抄出来的（原厂那份在
# system_ext 策略里，已经拿不到）。首次启动后请按实际 denial 调整：
#
#     adb shell dmesg | grep avc
#     adb shell logcat | grep avc
#
# 有 denial 就按提示补 allow，多授的权限再逐步收回。

# 打开块设备读 preloader 头部
allow mtk_plpath_utils block_device:dir search;
allow mtk_plpath_utils block_device:blk_file { open read getattr ioctl };

# 通过 device-mapper 建 pl_a / pl_b
# 注意：/dev/device-mapper 和 /dev/block/dm-* 的类型都是 dm_device
#      （实测平台 plat_file_contexts 第 153、439 行），**没有** dm_control 这个类型。
allow mtk_plpath_utils dm_device:chr_file { open read write ioctl };
allow mtk_plpath_utils self:capability { sys_admin sys_rawio };

# 判断存储类型要读 sysfs
# 原 A12 的 sysfs_block 类型在 A16（platform 36.0）已删除，编译报：
#   ERROR 'unknown type sysfs_block'（checkpolicy -c 30）
# 替换为 A16 的实际标签：
#   - 虚拟块设备 /sys/devices/virtual/block/* → sysfs_devices_block（public/file.te:104）
#   - 物理块设备节点无专属 genfs 标签 → 落到通用 sysfs
# （dash / MTK 自家 sepolicy 对 root 工具同样放行通用 sysfs 读：
#   recovery.te:19 / factory.te:283 / hal_bootctl_default.te:6）
allow mtk_plpath_utils sysfs_devices_block:file r_file_perms;
allow mtk_plpath_utils sysfs_devices_block:dir r_dir_perms;
allow mtk_plpath_utils sysfs:file r_file_perms;
allow mtk_plpath_utils sysfs:dir r_dir_perms;
